<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FUNewsManagementSystem</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-light bg-white border-bottom mb-3" aria-label="Điều hướng chính">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">FUNews</a>
                <div class="d-flex flex-wrap gap-3 align-items-center">
                    <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    <a class="nav-link text-dark" asp-controller="News" asp-action="Index">Tin tức</a>
                    @if (User.Identity?.IsAuthenticated == true) {
                        @if (User.IsInRole(AppRoles.Admin)) {
                            <a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">Tài khoản</a>
                            <a class="nav-link text-dark" asp-controller="Report" asp-action="Index">Báo cáo</a>
                        }
                        @if (User.IsInRole(AppRoles.Staff)) {
                            <a class="nav-link text-dark" asp-controller="Staff" asp-action="Index">Danh mục</a>
                            <a class="nav-link text-dark" asp-controller="NewsManagement" asp-action="Index">Bài viết</a>
                            <a class="nav-link text-dark" asp-controller="TagManagement" asp-action="Index">Tag</a>
                        }
                        @if (User.IsInRole(AppRoles.Staff) || User.IsInRole(AppRoles.Lecturer)) {
                            <a class="nav-link text-dark" asp-controller="Account" asp-action="History">Bài viết của tôi</a>
                        }
                        <a class="nav-link text-dark" asp-controller="Account" asp-action="Index">@User.Identity.Name</a>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Đăng xuất</button>
                        </form>
                    } else {
                        <a class="btn btn-primary btn-sm" asp-controller="Auth" asp-action="Login">Đăng nhập</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top py-3 text-muted">
        <div class="container">&copy; @DateTime.Now.Year - FUNewsManagementSystem</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
