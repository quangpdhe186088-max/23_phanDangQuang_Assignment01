@model NewsArticleDto
@{ ViewData["Title"] = Model.NewsTitle ?? "Chi tiết tin tức"; }
<article class="py-3">
    <p class="text-muted">@(Model.CategoryName ?? "Chưa phân loại") · @NewsDisplay.LocalTime(Model.CreatedDate) (giờ VN)</p>
    <h1 style="overflow-wrap: anywhere;">@(Model.NewsTitle ?? "Bài viết")</h1>
    <p class="text-muted">Tác giả: @(Model.CreatedByName ?? "Chưa xác định")</p>
    <p class="lead" style="overflow-wrap: anywhere;">@Model.Headline</p>
    <div class="my-4" style="white-space: pre-wrap; overflow-wrap: anywhere;">@Model.NewsContent</div>
    @if (!string.IsNullOrWhiteSpace(Model.NewsSource)) {
        <p style="overflow-wrap: anywhere;">Nguồn: @Model.NewsSource</p>
    }
    @if (Model.Tags.Count > 0) {
        <div class="d-flex flex-wrap gap-2 mb-4" aria-label="Tag bài viết">
            @foreach (var tag in Model.Tags) {
                <span class="badge bg-light text-dark border">@(tag.TagName ?? $"#{tag.TagId}")</span>
            }
        </div>
    }
</article>
<a asp-action="Index" class="btn btn-outline-secondary mb-4">Về danh sách tin</a>
