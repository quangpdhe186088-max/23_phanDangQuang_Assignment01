@model CategoryManagementViewModel
@{ ViewData["Title"] = "Quản lý danh mục"; }
<h1 class="h2">Quản lý danh mục</h1>
<p class="text-muted">Tổng cộng @Model.Categories.TotalCount danh mục trong danh sách.</p>
@if (TempData["Success"] is string success) { <p class="text-success" role="status">@success</p> }
@if (TempData["Error"] is string error) { <p class="text-danger" role="alert">@error</p> }
<div class="d-flex flex-wrap justify-content-between gap-3 my-4">
    <form asp-action="Index" method="get" class="d-flex gap-2">
        <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Tìm tên hoặc mô tả" aria-label="Tìm tên hoặc mô tả" />
        <button class="btn btn-outline-primary text-nowrap" type="submit">Tìm kiếm</button>
        @if (!string.IsNullOrEmpty(Model.Search)) { <a asp-action="Index" class="btn btn-outline-secondary text-nowrap">Xóa lọc</a> }
    </form>
    <a asp-action="Create" asp-route-page="@Model.Categories.Page" asp-route-search="@Model.Search" class="btn btn-primary">Thêm danh mục</a>
</div>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th scope="col">Mã</th><th scope="col">Tên danh mục</th><th scope="col">Mô tả</th><th scope="col">Danh mục cha</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead>
        <tbody>
        @foreach (var category in Model.Categories.Items) {
            <tr><td>@category.CategoryId</td><td>@category.CategoryName</td><td>@category.CategoryDescription</td>
                <td>@(category.ParentCategoryName ?? "Không có")</td>
                <td>@(category.IsActive == true ? "Hoạt động" : "Không hoạt động")</td>
                <td><div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@category.CategoryId" asp-route-page="@Model.Categories.Page" asp-route-search="@Model.Search" class="btn btn-outline-primary btn-sm">Sửa</a>
                    <form asp-action="Delete" method="post" class="m-0" onsubmit="return confirm('Bạn có chắc muốn xóa danh mục này?');">
                        <input type="hidden" name="id" value="@category.CategoryId" />
                        <input type="hidden" name="page" value="@Model.Categories.Page" />
                        <input type="hidden" name="search" value="@Model.Search" />
                        <button class="btn btn-outline-danger btn-sm" type="submit">Xóa</button>
                    </form>
                </div></td>
            </tr>
        }
        </tbody>
    </table>
</div>
@if (Model.Categories.Items.Count == 0) { <p>Không tìm thấy danh mục phù hợp.</p> }
<nav class="d-flex gap-3 align-items-center" aria-label="Phân trang danh mục">
    @if (Model.Categories.HasPrevious) { <a asp-action="Index" asp-route-page="@(Model.Categories.Page - 1)" asp-route-search="@Model.Search">Trang trước</a> }
    <span>Trang @Model.Categories.Page</span>
    @if (Model.Categories.HasNext) { <a asp-action="Index" asp-route-page="@(Model.Categories.Page + 1)" asp-route-search="@Model.Search">Trang sau</a> }
</nav>
<div class="modal fade" id="category-modal" tabindex="-1" aria-labelledby="category-modal-title" aria-hidden="true" data-open="@(Model.ModalMode is not null ? "true" : "false")">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header">
            <h2 class="modal-title fs-5" id="category-modal-title">@(Model.ModalMode == "Edit" ? "Sửa danh mục" : "Thêm danh mục")</h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
        </div>
        <form asp-action="@(Model.ModalMode == "Edit" ? "Edit" : "Create")" method="post">
            <div class="modal-body">
                <input asp-for="Form.CategoryId" type="hidden" />
                <input name="page" type="hidden" value="@Model.Categories.Page" />
                <input name="search" type="hidden" value="@Model.Search" />
                <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                <div class="mb-3"><label asp-for="Form.CategoryName" class="form-label"></label>
                    <input asp-for="Form.CategoryName" class="form-control" maxlength="100" />
                    <span asp-validation-for="Form.CategoryName" class="text-danger"></span></div>
                <div class="mb-3"><label asp-for="Form.CategoryDescription" class="form-label"></label>
                    <textarea asp-for="Form.CategoryDescription" class="form-control" maxlength="250" rows="3"></textarea>
                    <span asp-validation-for="Form.CategoryDescription" class="text-danger"></span></div>
                <div class="mb-3"><label asp-for="Form.ParentCategoryId" class="form-label"></label>
                    <select asp-for="Form.ParentCategoryId" class="form-select">
                        <option value="">Không có danh mục cha</option>
                        @foreach (var parent in Model.ParentOptions) {
                            <option value="@parent.CategoryId">@parent.CategoryName@(parent.IsActive == true ? "" : " (Không hoạt động)")</option>
                        }
                    </select>
                    <span asp-validation-for="Form.ParentCategoryId" class="text-danger"></span></div>
                <div class="form-check mb-3">
                    <input asp-for="Form.IsActive" class="form-check-input" />
                    <label asp-for="Form.IsActive" class="form-check-label"></label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-primary">Lưu</button>
            </div>
        </form>
    </div></div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const categoryModal = document.getElementById('category-modal');
        if (categoryModal.dataset.open === 'true') {
            bootstrap.Modal.getOrCreateInstance(categoryModal).show();
        }
    </script>
}
